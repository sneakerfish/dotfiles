<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.morello.sync-local-hosts</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/richardmorello/dotfiles/bin/sync-local-hosts.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Fire whenever DNS / network configuration changes. macOS rewrites
         /etc/resolv.conf and /var/run/resolv.conf on every network event. -->
    <key>WatchPaths</key>
    <array>
        <string>/etc/resolv.conf</string>
        <string>/var/run/resolv.conf</string>
    </array>

    <!-- Coalesce bursts of network-change events. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/var/log/sync-local-hosts.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/sync-local-hosts.log</string>
</dict>
</plist>
